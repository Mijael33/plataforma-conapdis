<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ==================== HEADERS DE SEGURIDAD ====================
<IfModule mod_headers.c>
    # Evita que el navegador "adivine" el tipo de archivo (anti-MIME sniffing)
    Header always set X-Content-Type-Options "nosniff"
    
    # Evita que otros sitios incrusten esta página en un iframe (anti-clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Filtro XSS para navegadores antiguos
    Header always set X-XSS-Protection "1; mode=block"
    
    # Controla cuánta información de la URL se comparte al navegar a otros sitios
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Descomentar solo cuando el sitio use HTTPS en producción:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ==================== PROTECCIONES ADICIONALES ====================

# Evitar que se liste el contenido de las carpetas
Options -Indexes

# Limitar tamaño de subida de archivos
php_value upload_max_filesize 20M
php_value post_max_size 25M
php_value max_execution_time 300
php_value max_input_time 300

# Bloquear acceso a archivos sensibles
<FilesMatch "\.(env|json|config.js|md|gitignore|gitattributes|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Proteger específicamente el archivo .env
<Files .env>
    Order allow,deny
    Deny from all
</Files>